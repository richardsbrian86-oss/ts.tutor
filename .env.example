# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# Get a key at https://console.anthropic.com/settings/keys
# Never commit .env - it is listed in .gitignore for that reason.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5.
# TUTOR_MODEL=claude-opus-5

# Optional. low | medium | high | xhigh | max. Lower spends fewer tokens.
# TUTOR_EFFORT=high
